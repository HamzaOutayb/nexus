# Copy this file to .env and replace the placeholder values with real secrets.
# The application and docker-compose files will use the values from .env when present.

# Shared application secrets
JWT_SECRET=change-this-development-secret-key-which-is-long-enough
INTERNAL_SERVICE_TOKEN=development-internal-service-token
HTTPS_KEYSTORE_PASSWORD=changeit

# Service URLs
PRODUCT_SERVICE_URL=http://product-service:8082
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka
KAFKA_BOOTSTRAP_SERVERS=kafka:19092

# MongoDB connection strings
USER_MONGODB_URI=mongodb://user-mongodb:27017/user-service-db
PRODUCT_MONGODB_URI=mongodb://product-mongodb:27017/product-service-db
ORDER_MONGODB_URI=mongodb://order-mongodb:27017/order-service-db
MEDIA_MONGODB_URI=mongodb://media-mongodb:27017/media-service-db

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Jenkins / SonarQube (optional for CI)
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me
GITHUB_REPOSITORY_URL=https://github.com/HamzaOutayb/buy-02.git
GITHUB_USERNAME=your-github-user
GITHUB_TOKEN=your-github-token
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=smtp@mailtrap.io
SMTP_PASSWORD=change-me
SMTP_FROM=smtp@mailtrap.io
NOTIFICATION_EMAIL=your-email@example.com
SONAR_DB_PASSWORD=sonar-local-password
SONAR_TOKEN=
PODMAN_SOCKET_PATH=/run/user/1000/podman/podman.sock
